# 高德地图 Web API Key（从 https://console.amap.com 申请）
AMAP_KEY=your_amap_api_key_here

# 服务端口
PORT=3000

# 缓存过期时间（秒）
CACHE_TTL=1800

# PostgreSQL 连接；可使用 Supabase、Neon 或其他兼容 PostgreSQL 服务
DATABASE_URL=postgresql://user:password@host:5432/ai_eat
DATABASE_SSL=false
DATABASE_POOL_SIZE=5
DATABASE_CONNECTION_TIMEOUT_MS=30000

# Supabase Auth 公共配置（不要在后端或前端使用 service_role key）
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key

# 必须先加入 Supabase Authentication > URL Configuration 的允许跳转地址
AUTH_EMAIL_REDIRECT_URL=http://localhost:5173/auth/callback
AUTH_PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/auth/reset-password

# 至少 32 个随机字符；上线后不可随意更换，否则历史风控主体无法关联
IDENTITY_HASH_SECRET=replace_with_a_stable_random_secret_at_least_32_chars

# 生产环境应填写网页正式域名；多个来源用英文逗号分隔
ALLOWED_ORIGINS=http://localhost:5173,https://ai-eat.vercel.app

# Vercel Cron 调用半月评分结算接口时使用；生产环境至少 16 个随机字符
CRON_SECRET=replace_with_a_long_random_secret
